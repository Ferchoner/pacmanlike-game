{
  "name": "search-and-run",
  "private": true,
  "version": "0.2.0-beta.1",
  "description": "Search and Run: juego 2D arcade de laberinto (Phaser 4 + TypeScript + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:itch": "npm run build && node tools/release/packageItch.ts",
    "package:itch:prueba": "npm run build && node tools/release/packageItch.ts --prueba",
    "package:itch:beta": "npm run build && node tools/release/packageItch.ts --beta",
    "level:check": "node tools/levels/checkLevel.ts",
    "level:export-nivel1": "node tools/levels/exportLevel1ToTiled.ts"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
